    <string name="roadmap_ai_control_text">Direct control over the AI that answers you. Still ahead in later Betas: a visual view of a chat\'s branches and comparing models side by side.</string>
    <string name="roadmap_back_desc">Back to About &amp; updates</string>
    <string name="roadmap_e1_d">Orbit choosing on-device or cloud by itself, from the task, what is available, and your preference.</string>
    <string name="roadmap_e1_t">Hybrid Auto</string>
    <string name="roadmap_e2_d">Helpful context-aware assistance that remains transparent and controllable.</string>
    <string name="roadmap_e2_t">Proactive screen intelligence</string>
    <string name="roadmap_e3_d">The same guided sessions for repairs, cleaning, assembly, and anything else done with full hands.</string>
    <string name="roadmap_e3_t">Hands-busy help beyond cooking</string>
    <string name="roadmap_e4_d">Careful answers on cooking temperatures, storage and reheating, written to be trustworthy rather than alarming.</string>
    <string name="roadmap_e4_t">Food safety guidance</string>
    <string name="roadmap_group_exploring">EXPLORING</string>
    <string name="roadmap_group_later">LATER</string>
    <string name="roadmap_group_now">NOW - ON THE WAY TO 0.9</string>
    <string name="roadmap_intro">Orbit\'s roadmap is a direction, not a promise of dates or release numbers. It starts with what is being built now. Shipped features stay in What\'s New; this page remains future-only.</string>
    <string name="roadmap_l10_d">A cooking session you start on purpose and end when you\'re done, following a recipe with you step by step.</string>
    <string name="roadmap_l10_t">Cook with Orbit</string>
    <string name="roadmap_l11_d">Short spoken commands while cooking, on the Voice you already use: next, back, repeat, how much.</string>
    <string name="roadmap_l11_t">Kitchen hands-free</string>
    <string name="roadmap_l12_d">Reading a whole recipe, scaling all of it at once, suggesting substitutions and a sensible order of work.</string>
    <string name="roadmap_l12_t">Recipe intelligence</string>
    <string name="roadmap_l13_d">An optional alternative to your Clock app for several named timers at once. Off by default; your Clock app stays.</string>
    <string name="roadmap_l13_t">Orbit-managed timers</string>
    <string name="roadmap_l1_d">Optional advanced organization built on top of the Free Vault.</string>
    <string name="roadmap_l1_t">Vault Pro organization</string>
    <string name="roadmap_l2_d">Additional power-user backup and export controls without removing the Free backup path.</string>
    <string name="roadmap_l2_t">Backup and export Pro</string>
    <string name="roadmap_l3_d">A real entitlement provider only when Orbit is ready for store distribution.</string>
    <string name="roadmap_l3_t">Play distribution and Billing</string>
    <string name="roadmap_l4_d">Growing what Orbit Local can act on by itself, beyond the safe set of controls it understands today.</string>
    <string name="roadmap_l4_t">Local device actions</string>
    <string name="roadmap_l5_d">Orbit reading your day back to you, and changing or removing events it added for you.</string>
    <string name="roadmap_l5_t">Calendar awareness</string>
    <string name="roadmap_l6_d">Several decision points in one Routine, and conditions beyond time and place.</string>
    <string name="roadmap_l6_t">More branch points &amp; conditions</string>
    <string name="roadmap_l7_d">Personal phrases that accept variation and detail, beyond today\'s exact wording.</string>
    <string name="roadmap_l7_t">Stronger Custom Commands</string>
    <string name="roadmap_l8_d">Broader device controls through supported Android surfaces.</string>
    <string name="roadmap_l8_t">Deeper Android actions</string>
    <string name="roadmap_l9_d">A choice of on-device models sized to different phones and needs.</string>
    <string name="roadmap_l9_t">More local models</string>
    <string name="roadmap_ms_ai_control">AI Control</string>
    <string name="roadmap_ms_orbit_local">Orbit Local 2.0</string>
    <string name="roadmap_ms_smart_vault">Smart Vault</string>
    <string name="roadmap_orbit_local_text">More of Orbit working privately on your phone. Still ahead: a choice of a larger Enhanced model on capable phones, and more on-device abilities as they can be done honestly. A request sent to Orbit Local always stays on the phone.</string>
    <string name="roadmap_smart_vault_text">What comes next for the Vault\'s search and suggestions: suggestions from more AI providers, tappable sources in Ask Vault answers, Ask Vault from the Side button, richer retrieval across whole saved documents, and room for more than 300 items. Always explicit, never automatic, and always Free.</string>
